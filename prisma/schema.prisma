generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(cuid())
  email     String        @unique
  name      String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  projects  BOMProject[]
  settings  UserSettings?
}

model BOMProject {
  id            String        @id @default(cuid())
  projectNumber String        @unique
  packageName   String
  name          String?
  description   String?
  status        ProjectStatus @default(DRAFT)
  version       String        @default("1.0")
  metadata      Json?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  authorId      String
  exports       BOMExport[]
  items         BOMItem[]     @relation("ProjectItems")
  author        User          @relation(fields: [authorId], references: [id])
  locations     Location[]
  binLabels     BinLabel[]
  glenairConfigs GlenairPartConfig[]

  @@index([status])
  @@index([authorId])
  @@index([projectNumber])
}

model Location {
  id         String      @id @default(cuid())
  name       String
  exportName String?
  order      Int         @default(0)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  projectId  String
  exports    BOMExport[] @relation("LocationExports")
  items      BOMItem[]
  binLabels  BinLabel[]
  project    BOMProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@index([order])
}

model BOMItem {
  id                   String     @id @default(cuid())
  partNumber           String
  description          String
  secondaryDescription String?
  quantity             Float
  unit                 String
  unitPrice            Float?
  manufacturer         String?
  supplier             String?
  category             String?
  referenceDesignator  String?
  isSpare              Boolean    @default(false)
  status               ItemStatus @default(ACTIVE)
  metadata             Json?
  order                Int        @default(0)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  projectId            String
  locationId           String
  location             Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  project              BOMProject @relation("ProjectItems", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, locationId, partNumber])
  @@index([projectId])
  @@index([locationId])
  @@index([status])
  @@index([category])
  @@index([projectId, locationId])
  @@index([manufacturer])
  @@index([order])
}

model BOMExport {
  id         String       @id @default(cuid())
  filename   String
  format     ExportFormat
  content    String
  version    String
  exportedAt DateTime     @default(now())
  projectId  String
  locationId String?
  location   Location?    @relation("LocationExports", fields: [locationId], references: [id], onDelete: Cascade)
  project    BOMProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([format])
  @@index([locationId])
}

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  contact   String?
  email     String?
  phone     String?
  address   String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Manufacturer {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String?  @unique
  website   String?
  contact   String?
  email     String?
  phone     String?
  address   String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String?    @unique
  description String?
  parentId    String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
}

model MasterPart {
  id                   String   @id @default(cuid())
  partNumber           String   @unique
  manufacturer         String
  description          String
  secondaryDescription String?
  category             String?
  unitPrice            Float?
  currency             String?
  supplier             String?
  lastUpdated          DateTime @default(now()) @updatedAt
  source               String   @default("csv-import")
  importDate           DateTime @default(now())
  createdAt            DateTime @default(now())

  @@index([partNumber])
  @@index([manufacturer])
  @@index([description])
  @@index([category])
  @@index([manufacturer, category])
}

model UserSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum ItemStatus {
  ACTIVE
  OBSOLETE
  PENDING
  DISCONTINUED
}

enum ExportFormat {
  EPLAN
  XML
  JSON
  CSV
  EXCEL
}

model BinLabel {
  id              String     @id @default(cuid())
  projectId       String
  locationId      String
  projectNumber   String     // From BOMProject
  kitString       String     // PackageName_LocationName (e.g., "Z2_EC1")
  description     String     // User input
  buildQty        Int        // User input
  buildingCode    String     // User input: "1", "2"
  rackNumber      String     // User input: "45A", "12B"
  category        String     // "Panel" or "Field"
  qrCodeData      String     // Computed: B1-45A-2-E1
  binLocation     String     // Formatted: "Building 1 / Bin 45A"
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  project         BOMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location        Location   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  
  @@index([projectId])
  @@index([locationId])
}

// Glenair Integration Models
model GlenairCatalog {
  id          String         @id @default(cuid())
  name        String
  version     String
  uploadedAt  DateTime       @default(now())
  tables      GlenairTable[]
  
  @@index([name])
}

model GlenairTable {
  id         String         @id @default(cuid())
  catalogId  String
  type       String         // "wire_map", "arrangement", "phm", "pin", "socket"
  page       Int
  headers    Json           // Column headers
  data       Json           // Row data
  catalog    GlenairCatalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  
  @@index([catalogId])
  @@index([type])
}

model GlenairPartConfig {
  id             String     @id @default(cuid())
  projectId      String
  wireSystem     String     // "AWG" or "MM2"
  wireValue      String
  conductorCount Int
  shellStyle     String     // "Plug (06)", "Inline Socket (01)", "Panel Mount (00)"
  arrangement    String
  contactSize    String
  phmSize        String
  partNumber     String     // Generated part number
  contacts       Json       // Selected contacts with quantities
  createdAt      DateTime   @default(now())
  project        BOMProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@unique([projectId, arrangement, wireValue])
  @@index([projectId])
  @@index([partNumber])
}
